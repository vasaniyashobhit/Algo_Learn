{
  "name": "algolearn",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/mvnw.mjs verify && npm test -w frontend",
    "test:cov": "npm run test:cov -w frontend",
    "lint": "node scripts/mvnw.mjs -q checkstyle:check && eslint .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "import:dataset": "node scripts/mvnw.mjs -q spring-boot:run -Dspring-boot.run.arguments=--task=import-dataset",
    "sync:problemset": "node scripts/mvnw.mjs -q spring-boot:run -Dspring-boot.run.arguments=--task=sync-problemset",
    "check:coach": "node scripts/mvnw.mjs -q spring-boot:run -Dspring-boot.run.arguments=--task=check-coach",
    "check:server": "node tools/checks/server.js",
    "check:stuck": "node tools/checks/stuck.js",
    "check:ocr": "node tools/checks/ocr-docker.mjs",
    "e2e": "npm run e2e -w e2e",
    "e2e:server": "node e2e/server/start.js",
    "parity": "node tools/parity/run.mjs",
    "build": "npm run build -w frontend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.13.0"
  }
}
