{
  "name": "cp-coach",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend --if-present\"",
    "test": "npm test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
