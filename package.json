{
  "name": "cp-coach",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend --if-present\"",
    "test": "npm test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "lint": "eslint .",
    "import:dataset": "npm run import:dataset -w backend",
    "sync:problemset": "npm run sync:problemset -w backend",
    "check:env": "npm run check:env -w backend",
    "check:atlas": "npm run check:atlas -w backend",
    "check:server": "npm run check:server -w backend",
    "check:gemini": "npm run check:gemini -w backend",
    "check:stuck": "npm run check:stuck -w backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
