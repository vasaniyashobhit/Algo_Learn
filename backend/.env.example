# Copy to backend/.env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cp-coach?retryWrites=true&w=majority

# Long random string, at least 32 characters (e.g. `node -e "console.log(crypto.randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Google AI Studio key and model list (primary first, comma separated)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Optional Groq fallback provider (leave empty to disable)
GROQ_API_KEY=
GROQ_MODEL=

# Shared secret for the protected hosted-cron HTTP trigger (at least 16 characters)
CRON_SECRET=replace-with-a-random-cron-secret
SYNC_CRON="0 */6 * * *"

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
