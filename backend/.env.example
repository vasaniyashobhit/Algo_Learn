# Copy to backend/.env and fill in real values. Never commit .env.
# Loaded in dev by spring-dotenv; real environment variables always win.

# Leave empty for development; "prod" in production (no stack traces in error responses).
SPRING_PROFILES_ACTIVE=
PORT=4000

# PostgreSQL (matches docker-compose.yml for local development)
DATABASE_URL=jdbc:postgresql://localhost:5432/algolearn
DATABASE_USERNAME=algolearn
DATABASE_PASSWORD=algolearn

# Long random string, at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (no trailing slash needed)
CLIENT_URL=http://localhost:5173

# Google AI Studio key and model list (primary first, comma separated)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Optional Groq fallback provider (leave empty to disable)
GROQ_API_KEY=
GROQ_MODEL=

# Shared secret for the protected hosted-cron HTTP trigger (at least 16 characters)
CRON_SECRET=replace-with-a-random-cron-secret
# 5-field cron (minute hour day month weekday)
SYNC_CRON=0 */6 * * *

# trace | debug | info | warn | error | fatal | off
LOG_LEVEL=info

# Optional: folder holding eng.traineddata for OCR (the Docker image sets it). Without it OCR counts as failed.
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
